{
  // Repo-local, so it applies however VisibleGov is opened — folder or workspace.
  //
  // The equivalent excludes previously lived in F:\VisibleGov.code-workspace, which covered 13
  // folders across several drives. That workspace was trimmed to VisibleGov alone on 2026-08-29,
  // and settings in a .code-workspace file do not apply when the folder is opened directly — so
  // these moved here rather than being lost with it.
  //
  // What this is NOT for: the Pylance "large number of source files" warning is gone on its own.
  // It was caused by ~36,000 .py files in the OTHER workspace folders (mostly four virtualenvs);
  // VisibleGov itself contains exactly one Python file, a scratch script under .superpowers.
  //
  // What it IS for: 1.1 GB of cached source payloads under .superpowers/artifacts plus 139 MB of
  // node_modules. Those are re-fetchable and gitignored, and having the editor watch and index
  // them costs real responsiveness for no benefit — see docs/ARTIFACTS.md for what they are and
  // what re-fetching them would cost.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.superpowers/artifacts/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.superpowers/artifacts": true
  },
  // Deliberately NOT excluded from search: supabase/migrations, tests/fixtures, and the .md
  // ledgers. Those are exactly what someone greps for when tracing why a decision was made, and
  // this project's own rule is that the record is the point.
  "files.exclude": {},

  // ---- Python interpreter (added 2026-10-06) ----
  //
  // VS Code reported "An invalid Python interpreter is selected". The selected one was
  // C:\Users\lance\AppData\Local\Python\bin\python.exe, which is NOT an interpreter: it is a
  // 605KB launcher SHIM, hardlinked to python3.exe / python3.14.exe / python3-64.exe in the same
  // directory, that re-execs the real binary. The extension cannot introspect a shim (no sys.prefix,
  // no stdlib path of its own), so it correctly refuses it. `python -c "import sys;
  // print(sys.executable)"` from a shell reports the REAL path, which is why the shim works fine
  // for command-line use and only the editor complains.
  //
  // Pinned to the real interpreter, verified to introspect: prefix and stdlib both resolve under
  // pythoncore-3.14-64, Python 3.14.3.
  "python.defaultInterpreterPath": "C:\\Users\\lance\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe",

  // VisibleGov is a Node project and contains NO Python source. The single .py in the tree is a
  // scratch script under .superpowers/artifacts/wave3/, which is gitignored re-fetchable payload -
  // excluding it keeps the Python extension from treating a throwaway as this project's codebase.
  // (Scripts Claude writes for one-off doc surgery live in the session scratchpad, outside the repo,
  // so they never reach the analyzer at all.)
  "python.analysis.exclude": [
    "**/.superpowers/**",
    "**/node_modules/**"
  ]
}
